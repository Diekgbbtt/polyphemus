# .env.example — copy to .env
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polymerhus
POSTGRES_DSN=postgresql://polymerhus:polymerhus@postgres:5432/polymerhus
KALI_MCP_URL=http://kali:8000/mcp
# MAX_PODS = per-job CONCURRENCY ceiling (pods running at once), NOT an asset cap.
MAX_PODS=8
# MAX_JOB_ASSETS = per-job total-work budget (max input assets a job processes,
# in waves of MAX_PODS). Safety cap for pathological inputs; raise for exhaustive scans.
MAX_JOB_ASSETS=500
MAX_POD_ITERS=3
EXEC_TIMEOUT_S=300
OUTPUT_BYTE_CAP=1048576
EMBED_MODEL=intfloat/e5-large-v2
EMBED_DIM=1024
# steel.dev cloud-browser API key. The steel_* crawl tools drive a steel.dev
# session via Playwright-over-CDP in-process; there is no MCP host URL.
STEEL_API_KEY=
PROJECT_ID=default
LANGGRAPH_STRICT_MSGPACK=true

# URL downloader limits (used by the ingestion service).
# These are validated by agent/app/config.py; only positive values are accepted.
URL_DOWNLOAD_CONNECT_TIMEOUT=10.0
URL_DOWNLOAD_READ_TIMEOUT=30.0
URL_DOWNLOAD_TOTAL_TIMEOUT=120.0
URL_DOWNLOAD_MAX_REDIRECTS=5
URL_DOWNLOAD_MAX_WIRE_BYTES=10485760
URL_DOWNLOAD_MAX_DECODED_BYTES=10485760
URL_DOWNLOAD_STREAM_CHUNK_SIZE=65536

# LightRAG methodology knowledge base (optional P0 service).
# The Docker services are behind the "lightrag" profile and mount pre-indexed
# KB snapshots from ./data/lightrag/rag_storage and
# ./data/lightrag/writeups_rag_storage. The agent stores retrieval artifacts in
# Postgres; it does not copy LightRAG's KB into Postgres.
LIGHTRAG_PORT=9621
LIGHTRAG_API_URL=http://lightrag:9621
LIGHTRAG_BASE_API_URL=http://lightrag:9621
# Local directory containing LightRAG storage (graph, kv stores, vectors).
LIGHTRAG_STORAGE_DIR=/data/lightrag/rag_storage
# Optional when you enable LightRAG auth. If set, client requests send X-API-Key.
LIGHTRAG_API_KEY=

# Ingestion service -> LightRAG timeout layers. These are three distinct limits:
# - LIGHTRAG_TIMEOUT_SECONDS=30: per-HTTP-request timeout for the ingestion
#   service's LightRAG API calls (document upload and each status poll).
# - LIGHTRAG_INGESTION_TIMEOUT_SECONDS=1800: whole-document polling deadline.
#   After upload, the ingestion service polls until LightRAG reaches a terminal
#   state or this deadline expires; expiry is reported as the stable sanitized
#   LIGHTRAG_TIMEOUT result.
# - LightRAG's own worker ceiling is configured inside the LightRAG image, not
#   here: it is derived as 2 x the role LLM timeout (observed 360s with the
#   current EXTRACT_LLM_TIMEOUT). A longer ingestion deadline does NOT repair a
#   stalled provider request; a terminal LightRAG failure is reported as the
#   stable sanitized LIGHTRAG_INGESTION_FAILED result.
LIGHTRAG_TIMEOUT_SECONDS=30
LIGHTRAG_INGESTION_TIMEOUT_SECONDS=1800
# Interval between LightRAG status polls during the ingestion deadline window.
LIGHTRAG_POLL_INTERVAL_SECONDS=2

# Local automated ingestion pipeline. On a VPS this host path can be mounted
# from /srv/polyphemus/ingestion into containers as /data/ingestion.
INGESTION_ROOT=/data/ingestion
INGESTION_NORMALIZED_DIR=/data/ingestion/normalized
N8N_PORT=5678
N8N_ENCRYPTION_KEY=local-dev-change-me-32-bytes-min
# n8n URL ingestion webhook shared secret (Header Auth).
# Documented variable name (comment only, never assign it):
# POLYPHEMUS_URL_INGESTION_WEBHOOK_SECRET
# n8n cannot create credentials from environment variables, and compose
# services share env_file: .env, so assigning this would inject the secret
# into containers that never consume it. Do not store this value in this file
# or in the project .env. Hold the value temporarily in your shell or in a
# password manager, then copy it manually into an n8n Header Auth credential:
#   Credentials -> New credential -> Header Auth
#     Credential name: Polyphemus URL Ingestion Secret
#     Name:  X-Polyphemus-Ingestion-Secret
#     Value: <the operator's secret>
# n8n stores the credential in its encrypted credential store. No Compose
# service receives this secret. Attach the credential to the "URL Ingestion
# Webhook" node of the imported "LightRAG URL ingestion" workflow
# (workflows/n8n/lightrag-url-ingestion.json, shipped inactive); after
# import, re-select it on the Webhook node if n8n reports it as missing.
# Do not automate credential creation or workflow activation.
# Local source allowlist for the agent-side LightRAG upload helper.
LIGHTRAG_APPROVED_SOURCES=data/lightrag/inputs,docs/design/lightrag
# The compose service is pinned to the LightRAG v1.5 line. ENTITY_TYPES was
# removed in v1.5; use an entity prompt profile under
# data/lightrag/prompts/entity_type instead.
# Keep false for the current zero-cost OpenRouter route (`tencent/hy3:free`):
# its provider rejects `response_format=json_object`.
ENTITY_EXTRACTION_USE_JSON=false
ENTITY_TYPE_PROMPT_FILE=methodology_entities.yml
# v1.5 parser route: try structured native parsing + table/equation processing
# + paragraph semantic chunking, then fall back to legacy recursive text parsing.
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
VLM_PROCESS_ENABLE=false
MAX_PARALLEL_INSERT=1
# Keep above the expected WSTG methodology graph size; default LightRAG 1000
# can truncate query context once staged ingestion passes the early batches.
MAX_GRAPH_NODES=5000
# Optional chunker knobs for preprocessed WSTG Markdown.
# CHUNK_P_SIZE=2000
# CHUNK_P_OVERLAP_SIZE=200
# CHUNK_R_SEPARATORS=["\n## ","\n### ","\n\n","\n"," ",""]
# LightRAG role-specific LLM backend. Replace placeholders in .env only.
# LightRAG v1.5.0rc3 roles are extract, keyword, query and vlm.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.swissai.svc.cscs.ch/v1
LLM_MODEL=DEEPSEEK_MODEL_SLUG_HERE
LLM_BINDING_API_KEY=SWISSAI_API_KEY_HERE
LLM_TIMEOUT=180
LLM_MAX_ASYNC=4

EXTRACT_LLM_BINDING=openai
EXTRACT_LLM_BINDING_HOST=https://api.swissai.svc.cscs.ch/v1
EXTRACT_LLM_MODEL=QWEN_3B_MODEL_SLUG_HERE
EXTRACT_LLM_BINDING_API_KEY=SWISSAI_API_KEY_HERE
EXTRACT_LLM_TIMEOUT=180
EXTRACT_LLM_MAX_ASYNC=2

KEYWORD_LLM_BINDING=openai
KEYWORD_LLM_BINDING_HOST=https://api.swissai.svc.cscs.ch/v1
KEYWORD_LLM_MODEL=QWEN_3B_MODEL_SLUG_HERE
KEYWORD_LLM_BINDING_API_KEY=SWISSAI_API_KEY_HERE
KEYWORD_LLM_TIMEOUT=180
KEYWORD_LLM_MAX_ASYNC=2

QUERY_LLM_BINDING=openai
QUERY_LLM_BINDING_HOST=https://api.swissai.svc.cscs.ch/v1
QUERY_LLM_MODEL=DEEPSEEK_MODEL_SLUG_HERE
QUERY_LLM_BINDING_API_KEY=SWISSAI_API_KEY_HERE
QUERY_LLM_TIMEOUT=180
QUERY_LLM_MAX_ASYNC=2

# Embeddings are separate from the agent LLM roles and must be configured before
# the first LightRAG indexing run. Do not change model/dimension after indexing
# without clearing ./data/lightrag/rag_storage. LightRAG v1.5.0rc3 supports
# Nemotron through the OpenAI-compatible embeddings API; keep base64 disabled
# because NVIDIA/OpenRouter expects float embeddings for this model.
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIM=2048
EMBEDDING_USE_BASE64=false
EMBEDDING_BINDING_API_KEY=OPENROUTER_API_KEY_HERE

# Future non-deterministic quality gate placeholder. This is not a LightRAG
# role in v1.5.0rc3 and is not consumed by the current ingestion service yet.
QUALITY_GATE_LLM_BINDING=openai
QUALITY_GATE_LLM_BINDING_HOST=https://api.swissai.svc.cscs.ch/v1
QUALITY_GATE_LLM_MODEL=DEEPSEEK_MODEL_SLUG_HERE
QUALITY_GATE_LLM_BINDING_API_KEY=SWISSAI_API_KEY_HERE
QUALITY_GATE_LLM_TEMPERATURE=0.3

# Langfuse tracing (optional, lightweight). Tracing is enabled only when ALL
# THREE of these are set; if any is empty the agent runs with tracing as a
# silent no-op (fail-open). Get keys from Langfuse Cloud (Settings -> API Keys)
# or your self-hosted instance. Set LANGFUSE_HOST to the region/base URL:
#   EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com
#   self-hosted: http://langfuse:3000 (or wherever your instance is reachable).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# Export throttling + at-least-once retry (optional; sane defaults if unset).
# langfuse's default 5s export timeout drops a batch outright on a read
# timeout with no retry - these knobs raise the timeout and add a bounded
# retry/backoff wrapper around span export so a slow/flaky Langfuse endpoint
# does not silently lose traces. A retried batch may duplicate spans that
# partially landed server-side before the timeout - accepted trade-off for
# at-least-once delivery. Always fail-open: wrapper errors degrade to the
# SDK default exporter, never break the run.
# LANGFUSE_EXPORT_TIMEOUT=30
# LANGFUSE_EXPORT_MAX_RETRIES=3
# LANGFUSE_EXPORT_RETRY_BACKOFF_S=1.0
# LANGFUSE_FLUSH_INTERVAL=5
# LANGFUSE_FLUSH_AT=512

## LLM provider configuration and models for agents involved in reconnaissance 
# key, either
# API_KEY_OPENROUTER= 
# or -- ofc only opeai models can be used is using openai, more details on value naming convention in readme
# OPENAI_API_KEY=
# LLM_MODEL_TRIAGER=openrouter:deepseek/deepseek-v4-flash
# LLM_MODEL_CONFIGURATOR=openrouter:openai/gpt-4.1-mini
# LLM_MODEL_JOB_ORCHESTRATOR=openrouter:deepseek/deepseek-v4-flash
# LLM_MODEL_CRAWLER=openrouter:deepseek/deepseek-v4-flash
# LLM_MODEL_METHODOLOGY_FORMATTER=openrouter:openai/gpt-4.1-mini
# LLM_MODEL_HUNTING=openrouter:deepseek/deepseek-v4-flash
# Per-request timeout, in seconds, for EVERY role's LLM call (#32). Default 300.
# Raise it if a legitimately slow call starts timing out - an analysis proposer
# that times out on every attempt fails CLOSED, which looks like a model failure
# rather than a too-tight budget. The slowest call seen so far is a Bootstrapper
# reasoning pass over a rich operator KB, at ~150s.
# LLM_REQUEST_TIMEOUT_SECONDS=300

# Discord webhook for out-of-band "interactive login required" alerts during
# authenticated agentic crawls. Optional and fail-open: unset = no notification.
# This is a SECRET - set the real value only in .env (gitignored), never here.
DISCORD_WEBHOOK_URL=
