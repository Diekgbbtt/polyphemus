# .env.example — copy to .env
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polymerhus
POSTGRES_DSN=postgresql://polymerhus:polymerhus@postgres:5432/polymerhus
KALI_MCP_URL=http://kali:8000/mcp
MAX_PODS=8
MAX_POD_ITERS=3
EXEC_TIMEOUT_S=300
OUTPUT_BYTE_CAP=1048576
EMBED_MODEL=intfloat/e5-large-v2
EMBED_DIM=1024
# steel.dev cloud-browser API key. The steel_* crawl tools drive a steel.dev
# session via Playwright-over-CDP in-process; there is no MCP host URL.
STEEL_API_KEY=
PROJECT_ID=default
LANGGRAPH_STRICT_MSGPACK=true

# Langfuse tracing (optional, lightweight). Tracing is enabled only when ALL
# THREE of these are set; if any is empty the agent runs with tracing as a
# silent no-op (fail-open). Get keys from Langfuse Cloud (Settings -> API Keys)
# or your self-hosted instance. Set LANGFUSE_HOST to the region/base URL:
#   EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com
#   self-hosted: http://langfuse:3000 (or wherever your instance is reachable).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
