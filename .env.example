# .env.example — copy to .env
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polymerhus
POSTGRES_DSN=postgresql://polymerhus:polymerhus@postgres:5432/polymerhus
KALI_MCP_URL=http://kali:8000/mcp
# MAX_PODS = per-job CONCURRENCY ceiling (pods running at once), NOT an asset cap.
MAX_PODS=8
# MAX_JOB_ASSETS = per-job total-work budget (max input assets a job processes,
# in waves of MAX_PODS). Safety cap for pathological inputs; raise for exhaustive scans.
MAX_JOB_ASSETS=500
MAX_POD_ITERS=3
EXEC_TIMEOUT_S=300
OUTPUT_BYTE_CAP=1048576
EMBED_MODEL=intfloat/e5-large-v2
EMBED_DIM=1024
# steel.dev cloud-browser API key. The steel_* crawl tools drive a steel.dev
# session via Playwright-over-CDP in-process; there is no MCP host URL.
STEEL_API_KEY=
PROJECT_ID=default
LANGGRAPH_STRICT_MSGPACK=true

# Langfuse tracing (optional, lightweight). Tracing is enabled only when ALL
# THREE of these are set; if any is empty the agent runs with tracing as a
# silent no-op (fail-open). Get keys from Langfuse Cloud (Settings -> API Keys)
# or your self-hosted instance. Set LANGFUSE_HOST to the region/base URL:
#   EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com
#   self-hosted: http://langfuse:3000 (or wherever your instance is reachable).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# Export throttling + at-least-once retry (optional; sane defaults if unset).
# langfuse's default 5s export timeout drops a batch outright on a read
# timeout with no retry - these knobs raise the timeout and add a bounded
# retry/backoff wrapper around span export so a slow/flaky Langfuse endpoint
# does not silently lose traces. A retried batch may duplicate spans that
# partially landed server-side before the timeout - accepted trade-off for
# at-least-once delivery. Always fail-open: wrapper errors degrade to the
# SDK default exporter, never break the run.
# LANGFUSE_EXPORT_TIMEOUT=30
# LANGFUSE_EXPORT_MAX_RETRIES=3
# LANGFUSE_EXPORT_RETRY_BACKOFF_S=1.0
# LANGFUSE_FLUSH_INTERVAL=5
# LANGFUSE_FLUSH_AT=512

## LLM provider configuration and models for agents involved in reconnaissance 
# key, either
# API_KEY_OPENROUTER= 
# or -- ofc only opeai models can be used is using openai, more details on value naming convention in readme
# OPENAI_API_KEY=
# LLM_MODEL_TRIAGER=openrouter:deepseek/deepseek-v4-flash
# LLM_MODEL_CONFIGURATOR=openrouter:openai/gpt-4.1-mini
# LLM_MODEL_JOB_ORCHESTRATOR=openrouter:deepseek/deepseek-v4-flash
# LLM_MODEL_CRAWLER=openrouter:deepseek/deepseek-v4-flash
# LLM_MODEL_HUNTING=openrouter:deepseek/deepseek-v4-flash
# Per-request timeout, in seconds, for EVERY role's LLM call (#32). Default 300.
# Raise it if a legitimately slow call starts timing out - an analysis proposer
# that times out on every attempt fails CLOSED, which looks like a model failure
# rather than a too-tight budget. The slowest call seen so far is a Bootstrapper
# reasoning pass over a rich operator KB, at ~150s.
# LLM_REQUEST_TIMEOUT_SECONDS=300

# Discord webhook for out-of-band "interactive login required" alerts during
# authenticated agentic crawls. Optional and fail-open: unset = no notification.
# This is a SECRET - set the real value only in .env (gitignored), never here.
DISCORD_WEBHOOK_URL=
