# The eval advancement daemon configuration.
# Install to /etc/polymerhus/eval-advance.env and reference from
# eval-advance.service via `EnvironmentFile=`. Every value is read by
# `advance.daemon.load_config_from_env`; nothing else configures the daemon.

# The worktree the CD controller fast-forwards on `dev` (delivery plane).
# The daemon only READS this HEAD; it never fetches into it.
EVAL_ADVANCE_DEV_WORKTREE=/opt/polymerhus/dev

# One or more eval worktrees, os.pathsep-separated (`:` on Linux). One advance
# moves all of them to the same commit (D36); they must start in lockstep.
EVAL_ADVANCE_EVAL_WORKTREES=/opt/polymerhus/eval-inst-1:/opt/polymerhus/eval-inst-2

# The app-state endpoint (the idle proxy). The daemon appends `/app-state`
# unless it is already present. `{"idle": bool, "projects": [...]}`.
EVAL_ADVANCE_APP_STATE_URL=http://127.0.0.1:8000

# Direct-postgres fallback used when the endpoint is unreachable (D26): the
# documented query in #265's route docstring / eval/OPERATOR.md, run via psql.
EVAL_ADVANCE_DSN=postgresql://polymerhus:polymerhus@127.0.0.1:5432/polymerhus

# Heartbeat file, rewritten atomically every poll. The last-known-good history
# is written beside it as `last-known-good.json` unless overridden below.
EVAL_ADVANCE_HEARTBEAT=/var/lib/polymerhus-eval/heartbeat.json

# Optional: override the last-known-good history location.
# EVAL_ADVANCE_LAST_KNOWN_GOOD=/var/lib/polymerhus-eval/last-known-good.json

# Seconds between polls.
EVAL_ADVANCE_POLL_INTERVAL=30

# Optional alert hook. When set, it is run as:
#   sh -c "$EVAL_ADVANCE_ALERT_COMMAND" eval-advance <kind> <message>
# The structured alert line is always logged regardless.
# EVAL_ADVANCE_ALERT_COMMAND=/usr/local/bin/eval-advance-alert

# Optional override for the repeated "dev ahead while idle" message text.
# EVAL_ADVANCE_DEV_AHEAD_MESSAGE=dev is ahead while all instances are idle

# The running-stack identity for the manifest's image digests (D39). The daemon
# runs `docker inspect` on each container to record the digest of the image
# actually running. `EVAL_ADVANCE_COMPOSE_PROJECT` names the containers
# (`<project>-<service>-1`); `EVAL_ADVANCE_IMAGE_CONTAINERS` overrides the map
# as `component=container,...` (components: postgres, neo4j, lightrag, kali,
# litellm, agent; litellm is the gateway process inside the agent container).
# If collection fails, the daemon alerts and refuses to advance (fail-closed).
# EVAL_ADVANCE_COMPOSE_PROJECT=polymerhus
# EVAL_ADVANCE_IMAGE_CONTAINERS=postgres=ph-arm-a-postgres-1,kali=ph-arm-a-kali-1,agent=ph-arm-a-agent-1
