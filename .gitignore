.env
secrets/
*.auth.local.json
__pycache__/
*.pyc
.pytest_cache/
.superpowers/
.worktrees/
.DS_Store
.venv/
lightrag/data/lightrag/rag_storage.bak.*/
lightrag/data/lightrag/benchmarks/*.sqlite3
lightrag/data/lightrag/benchmarks/ontology_query_benchmark*.json
lightrag/data/lightrag/inputs/*
!lightrag/data/lightrag/inputs/.gitkeep
lightrag/data/lightrag/prompts/*
!lightrag/data/lightrag/prompts/.gitkeep
!lightrag/data/lightrag/prompts/entity_type/
!lightrag/data/lightrag/prompts/entity_type/*.yml
lightrag/data/lightrag/preprocessing_pipeline/docs_to_process/
lightrag/data/lightrag/preprocessing_pipeline/normalized/
lightrag/data/lightrag/preprocessing_pipeline/preprocessed_docs/
lightrag/data/lightrag/preprocessing_pipeline/src/lightrag_docprep.egg-info/
lightrag/data/ingestion/*
!lightrag/data/ingestion/.gitkeep
!lightrag/data/ingestion/inbox/
lightrag/data/ingestion/inbox/*
!lightrag/data/ingestion/inbox/.gitkeep
!lightrag/data/ingestion/processed/
lightrag/data/ingestion/processed/*
!lightrag/data/ingestion/processed/.gitkeep
!lightrag/data/ingestion/failed/
lightrag/data/ingestion/failed/*
!lightrag/data/ingestion/failed/.gitkeep
!lightrag/data/ingestion/normalized/
lightrag/data/ingestion/normalized/*
!lightrag/data/ingestion/normalized/.gitkeep
docs/.DS_Store

# Agent-harness working state, not source. `.claude/worktrees/` holds live git
# worktrees (never nest those in a commit); the lock is per-machine runtime.
.claude/*
.agents/*
.control-plane/*

# Recon run artifacts (multi-MB per-target graph dumps), reproducible by re-running.
.recon-exports/
tests/e2e/fixtures/eval-targets.yaml

# The shared app-owned data root (#234): one directory per module per project
# (skills/, hunting/orchestration/, hunting/hunter/, hunting/test-executor-pod/).
# Run artifacts, reproducible by re-running. The fault-KB catalogue is the ONE
# tracked artifact: the image build copies it into the data root, and the
# loader fails closed if it is absent.
data/*
!data/.gitkeep
!data/hunting/fault-kb.yaml

# Build metadata (setuptools) and the local uv lockfile. Both are per-machine
# artifacts here: the project pins its dependencies in requirements-*.txt.
src/*.egg-info/
uv.lock

# Editor swap files (stray vim buffers on tracked markdown).
*.swp
*.swo
