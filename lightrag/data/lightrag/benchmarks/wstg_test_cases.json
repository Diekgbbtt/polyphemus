{
  "schema_version": 1,
  "corpus": "OWASP Web Security Testing Guide",
  "description": "Phase 2 abstracted web application profiles for benchmarking LightRAG WSTG hypothesis generation.",
  "cases": [
    {
      "test_case_id": "wstg-auth-session-spa-jwt-localstorage",
      "title": "SPA OAuth2 JWT token storage and reflected UI input",
      "phase2_abstracted_profile": {
        "application_type": "single_page_application",
        "frontend": ["React"],
        "backend_style": "JSON API",
        "auth_mechanisms": ["OAuth2 authorization code flow", "JWT bearer access token"],
        "token_storage": "localStorage",
        "observed_inputs": [
          "reflected search parameter",
          "client-rendered profile fields"
        ],
        "session_controls": [
          "no server-side session cookie",
          "logout clears browser storage only"
        ],
        "security_signals": [
          "missing Content-Security-Policy",
          "user-controlled HTML reflected into client route"
        ]
      },
      "expected_wstg_ids": [
        "WSTG-SESS-10",
        "WSTG-SESS-06",
        "WSTG-CLNT-01",
        "WSTG-CLNT-12",
        "WSTG-INPV-01",
        "WSTG-CONF-12"
      ],
      "expected_topics": [
        "JSON Web Tokens",
        "logout handling",
        "DOM based cross site scripting",
        "browser storage",
        "reflected cross site scripting",
        "content security policy"
      ],
      "evaluation_terms": [
        "JWT",
        "localStorage",
        "browser storage",
        "XSS",
        "logout",
        "session",
        "CSP"
      ]
    },
