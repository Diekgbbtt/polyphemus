<node id="GitLab">
  <data key="d0">GitLab</data>
  <data key="d1">technologystack</data>
  <data key="d2">A Git repository management platform used in the target environment.&lt;SEP&gt;An application platform technology stack relevant to the target environment.&lt;SEP&gt;A web-based Git repository manager.</data>
