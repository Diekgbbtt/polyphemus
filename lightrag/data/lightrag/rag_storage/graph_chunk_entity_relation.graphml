  <data key="d6"></data>
</node>
<node id="LDAP Search Filter">
  <data key="d0">LDAP Search Filter</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A parameterized query string passed to an LDAP search function, often embedding usernames, attributes, and logical operators.&lt;SEP&gt;A core LDAP component constructed from user input fields after manipulation by attackers.&lt;SEP&gt;A query string used to locate objects in an LDAP directory that is constructed according to the LDAPv3 grammar rules.</data>
  <data key="d3">doc-db3753bb1b28c5b9ebe5769dc9c06af2-chunk-002&lt;SEP&gt;doc-db3753bb1b28c5b9ebe5769dc9c06af2-chunk-000&lt;SEP&gt;doc-db3753bb1b28c5b9ebe5769dc9c06af2-chunk-001</data>
  <data key="d4">wstg-inpv-06-methodology.md</data>
  <data key="d5">1785416495</data>
  <data key="d6"></data>
</node>
<node id="LDAP Metacharacters">
  <data key="d0">LDAP Metacharacters</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A set of special characters such as \&amp;|\!*()[], used to construct or manipulate LDAP search filters within injection payloads.</data>
  <data key="d3">doc-db3753bb1b28c5b9ebe5769dc9c06af2-chunk-002</data>
  <data key="d4">wstg-inpv-06-methodology.md</data>
  <data key="d5">1785416495</data>
  <data key="d6"></data>
</node>
<node id="Polish Notation">
  <data key="d0">Polish Notation</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A prefix notation methodology used to construct logical operations within LDAP search filters.</data>
  <data key="d3">doc-db3753bb1b28c5b9ebe5769dc9c06af2-chunk-002</data>
  <data key="d4">wstg-inpv-06-methodology.md</data>
  <data key="d5">1785416495</data>
  <data key="d6"></data>
</node>
<node id="Web Application (LDAP Backend)">
  <data key="d0">Web Application (LDAP Backend)</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">The web-based application system that utilizes Lightweight Directory Access Protocol (LDAP) for user authentication or directory searches.</data>
