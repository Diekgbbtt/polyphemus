  <data key="d6"></data>
</node>
<node id="user privileges">
  <data key="d0">user privileges</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A database account permission condition that determines which native functions or files an authenticated user can access or manipulate.</data>
  <data key="d3">doc-df80c9fe91c3765dc83d86ba6565a823-chunk-003</data>
  <data key="d4">wstg-inpv-05-2-methodology.md</data>
