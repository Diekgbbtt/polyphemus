  <data key="d5">1787907591</data>
  <data key="d6"></data>
</node>
<node id="Response Time Delay">
  <data key="d0">Response Time Delay</data>
  <data key="d1">ObservableSignal</data>
  <data key="d2">An observable signal indicating slow response when a time-based or resource-consuming injected query executes.&lt;SEP&gt;An observable increase in page or API response time that can indicate slow or executed database queries.&lt;SEP&gt;Extended response duration after injection suggestive of command execution activity.</data>
  <data key="d3">doc-d8f69c7e813a7c5f87c603a15e656cb8-chunk-000&lt;SEP&gt;doc-d8f69c7e813a7c5f87c603a15e656cb8-chunk-012&lt;SEP&gt;doc-eff998e21395157f6ed4ce495ef006aa-chunk-000</data>
