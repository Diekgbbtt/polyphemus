<node id="Resource Owner">
  <data key="d0">Resource Owner</data>
  <data key="d1">AttackerCapability</data>
  <data key="d2">An entity (physical person or system) that grants temporary access to their protected resources via OAuth.&lt;SEP&gt;The entity who owns the resource being accessed and grants permissions to the client application.&lt;SEP&gt;A user or entity that owns the resources (data) and grants access permissions to client applications on their behalf.</data>
  <data key="d3">doc-f381850f068d5b79abeb8a970d52c486-chunk-000&lt;SEP&gt;doc-432cbf8013fe1cec9f0bb28ca6062ff9-chunk-003&lt;SEP&gt;doc-432cbf8013fe1cec9f0bb28ca6062ff9-chunk-000</data>
