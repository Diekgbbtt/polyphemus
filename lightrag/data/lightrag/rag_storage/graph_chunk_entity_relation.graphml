  <data key="d2">A systematic discovery process of all application inputs (GET, POST, file uploads, form fields) that can accept user-supplied data for testing.</data>
  <data key="d3">doc-2efb3aacf8e172b84b6e1793e84eff76-chunk-004</data>
  <data key="d4">wstg-athz-01-methodology.md</data>
  <data key="d5">1785416397</data>
  <data key="d6"></data>
