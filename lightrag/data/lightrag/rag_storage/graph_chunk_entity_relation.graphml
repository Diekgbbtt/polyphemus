  <data key="d0">Report-Only Content Security Policy</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">An implementation mode that logs violations without enforcing restrictions, providing no actual protection despite reporting.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-001</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
