  <data key="d6"></data>
</node>
<node id="native function load_file">
  <data key="d0">native function load_file</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An attack action that utilizes the `load_file()` function to read arbitrary files from the filesystem when permitted by `FILE` privileges.</data>
  <data key="d3">doc-df80c9fe91c3765dc83d86ba6565a823-chunk-003</data>
  <data key="d4">wstg-inpv-05-2-methodology.md</data>
