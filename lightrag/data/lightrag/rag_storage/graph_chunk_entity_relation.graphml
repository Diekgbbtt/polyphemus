  <data key="d1">AttackTechnique</data>
  <data key="d2">An action that passes untrusted parameters or values to the `navigateToURL` function, allowing attacker-controlled URIs to be loaded in the browser window.</data>
  <data key="d3">doc-fbf0208722534d321dede8c097bd3086-chunk-001</data>
  <data key="d4">wstg-clnt-08-methodology.md</data>
  <data key="d5">1785497857</data>
  <data key="d6"></data>
</node>
