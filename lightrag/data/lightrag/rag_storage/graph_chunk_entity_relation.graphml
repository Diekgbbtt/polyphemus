</node>
<node id="JavaScript Variable">
  <data key="d0">JavaScript Variable</data>
  <data key="d1">Artifact</data>
  <data key="d2">A named identifier in the JavaScript script where attacker-supplied input is stored and subsequently evaluated or executed.&lt;SEP&gt;Frontend JavaScript code variables that may contain sensitive information hardcoded by developers.</data>
  <data key="d3">doc-f4eb0f9a10aea7bceef93114d6569d66-chunk-001&lt;SEP&gt;doc-355889046c6513bd655625fa66e3f822-chunk-003</data>
