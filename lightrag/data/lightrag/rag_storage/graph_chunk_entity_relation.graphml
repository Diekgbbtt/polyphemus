<node id="File Include Vulnerability">
  <data key="d0">File Include Vulnerability</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness where the application trusts user-controlled paths to include unauthorized system files or sensitive information.</data>
  <data key="d3">doc-2efb3aacf8e172b84b6e1793e84eff76-chunk-004</data>
  <data key="d4">wstg-athz-01-methodology.md</data>
  <data key="d5">1785416397</data>
  <data key="d6"></data>
</node>
<node id="User Input Field">
  <data key="d0">User Input Field</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">An application field that accepts content from users and can act as an injection point for directory traversal attacks.&lt;SEP&gt;A target field, form field, comment section, or other area on a web page that accepts and stores user-provided data into the backend.</data>
  <data key="d3">doc-2efb3aacf8e172b84b6e1793e84eff76-chunk-004&lt;SEP&gt;doc-40abae0a95ecce566511731ae40acbbf-chunk-003</data>
