  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="GET-Request">
  <data key="d0">GET-Request</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">HTTP request method that browsers send automatically when opening a web page or following a link, often lacking user permission checks in vulnerable applications.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-000</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="Malicious Third-Party Site">
  <data key="d0">Malicious Third-Party Site</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">The attacker-controlled website that hosts the self-submitting form and tricks victims into visiting it.&lt;SEP&gt;A site controlled by the attacker used to host and deliver the CSRF exploit page to victims.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-007&lt;SEP&gt;doc-35af4670be2579d771f8aacc9dfbff92-chunk-003</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="Self-Submitting HTML Form">
  <data key="d0">Self-Submitting HTML Form</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A crafted HTML page containing an embedded form that automatically submits itself upon page load.&lt;SEP&gt;An HTML form configured to automatically submit POST requests when clicked.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-007&lt;SEP&gt;doc-35af4670be2579d771f8aacc9dfbff92-chunk-003</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="JSON Payload">
  <data key="d0">JSON Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">Reusable JSON data structure included within a form submission to bypass input field restrictions.</data>
