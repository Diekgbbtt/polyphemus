  <data key="d6"></data>
</node>
<node id="dynamic SQL">
  <data key="d0">dynamic SQL</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A programming condition that exists when application SQL queries are constructed by concatenating strings rather than using parameterized queries.</data>
  <data key="d3">doc-df80c9fe91c3765dc83d86ba6565a823-chunk-003</data>
  <data key="d4">wstg-inpv-05-2-methodology.md</data>
