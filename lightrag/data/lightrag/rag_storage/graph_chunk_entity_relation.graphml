<node id="Cache-Control Directive">
  <data key="d0">Cache-Control Directive</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">HTTP headers (e.g., `Cache-Control: no-cache`, `Cache-Control: max-age=0`, `Expires: 0`) controlling how intermediaries store session data.</data>
