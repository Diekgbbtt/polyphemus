  <data key="d0">nonces</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-002</data>
  <data key="d2">Ensures that dynamically delivered scripts are authorized and tied to a specific response instance.</data>
  <data key="d1">DefensiveControl</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578914</data>
  <data key="d6"></data>
</node>
<node id="inline scripts">
  <data key="d0">inline scripts</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-002</data>
