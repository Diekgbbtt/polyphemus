</node>
<node id="User-Controlled Input">
  <data key="d0">User-Controlled Input</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">Any data within the web application that is derived from client input and can be influenced or altered by the user.&lt;SEP&gt;Input that originates from the user and is processed by the web application.</data>
  <data key="d3">doc-a331af288c84a3d43384e1ec0cd67904-chunk-000&lt;SEP&gt;doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-000</data>
