  <data key="d0">nonce-based script control</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A CSP mechanism for script execution that uses nonce tokens to allow only authorized inline scripts while disallowing others.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-001</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="strict-dynamic">
  <data key="d0">strict-dynamic</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A CSP directive that improves security of dynamic script loading by including only assets from approved sources, but propagates trust from trusted scripts to loaded resources.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-001</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
