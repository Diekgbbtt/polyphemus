  <data key="d5">1785581601</data>
  <data key="d6"></data>
</node>
<node id="Remote Command Execution (RCE)">
  <data key="d0">Remote Command Execution (RCE)</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">A persistent level of access that allows running arbitrary system commands on targeted host.&lt;SEP&gt;The ultimate outcome an attacker strives for when successfully triggering SSI injection.</data>
  <data key="d3">doc-8572f501a826eda55dfbb3563ca66b07-chunk-000&lt;SEP&gt;doc-8572f501a826eda55dfbb3563ca66b07-chunk-001</data>
