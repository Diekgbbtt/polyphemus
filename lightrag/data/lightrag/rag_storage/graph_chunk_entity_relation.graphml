  <data key="d6"></data>
</node>
<node id="FILE privilege">
  <data key="d0">FILE privilege</data>
  <data key="d1">AttackerCapability</data>
  <data key="d2">An operational permission possessed by an attacker that allows reading arbitrary files through MySQL functions or attacks.</data>
  <data key="d3">doc-df80c9fe91c3765dc83d86ba6565a823-chunk-003</data>
  <data key="d4">wstg-inpv-05-2-methodology.md</data>
  <data key="d5">1785581176</data>
  <data key="d6"></data>
</node>
<node id="in to outfile clause">
  <data key="d0">in to outfile clause</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An exploitative SQL clause used to store query results into arbitrary server-side files for unauthorized file upload and exfiltration.</data>
  <data key="d3">doc-df80c9fe91c3765dc83d86ba6565a823-chunk-003</data>
  <data key="d4">wstg-inpv-05-2-methodology.md</data>
  <data key="d5">1785581176</data>
  <data key="d6"></data>
</node>
<node id="out of band injection">
  <data key="d0">out of band injection</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">An attack objective to achieve data exfiltration or command execution without relying on user error responses or result sets.</data>
  <data key="d3">doc-df80c9fe91c3765dc83d86ba6565a823-chunk-003</data>
  <data key="d4">wstg-inpv-05-2-methodology.md</data>
  <data key="d5">1785581176</data>
  <data key="d6"></data>
