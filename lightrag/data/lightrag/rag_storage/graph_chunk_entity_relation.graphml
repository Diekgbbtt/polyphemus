  <data key="d1">Artifact</data>
  <data key="d2">Active session identified by session cookie indicating logged-in state.&lt;SEP&gt;A session identifier stored on the client or server-side that authenticates the user across requests.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-007&lt;SEP&gt;doc-35af4670be2579d771f8aacc9dfbff92-chunk-002</data>
