<node id="Clickjacking Attacks">
  <data key="d0">Clickjacking Attacks</data>
  <data key="d3">doc-f381850f068d5b79abeb8a970d52c486-chunk-006</data>
  <data key="d2">The anti-clickjacking header blocks pages from being embedded in iframes to stop clickjacking.</data>
