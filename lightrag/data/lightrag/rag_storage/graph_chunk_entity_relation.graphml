  <data key="d1">PayloadPattern</data>
  <data key="d2">A specially crafted string containing directory traversal sequences such as `../` or platform-specific sequences to bypass validation boundaries.</data>
  <data key="d3">doc-2efb3aacf8e172b84b6e1793e84eff76-chunk-001</data>
  <data key="d4">wstg-athz-01-methodology.md</data>
  <data key="d5">1785416397</data>
  <data key="d6"></data>
