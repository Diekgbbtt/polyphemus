  <data key="d5">1785583470</data>
  <data key="d6"></data>
</node>
<node id="JavaScript Function">
  <data key="d0">JavaScript Function</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A condition where a JavaScript function is available to interact with within the DOM.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-003</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Query Fragment">
  <data key="d0">Query Fragment</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A URL fragment (starting with `#`) injected by an attacker that is not transmitted to the server but is rendered by the browser.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-003</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Server-Side Application">
  <data key="d0">Server-Side Application</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">The backend application that generates and dynamically renders the JavaScript and DOM structures on the client side.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-003</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Client-Side JavaScript Code">
  <data key="d0">Client-Side JavaScript Code</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Code written in JavaScript that resides in the user's browser and manipulates the Document Object Model.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-003</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="DOM-Based Cross Site Scripting (XSS)">
  <data key="d0">DOM-Based Cross Site Scripting (XSS)</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">Class of web security vulnerability where malicious scripts are injected into the Document Object Model by manipulating client-side data handling instead of server-side rendering.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="JavaScript Objects">
  <data key="d0">JavaScript Objects</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Client-side JavaScript objects such as window objects that may hold user-controlled data used in DOM operations.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
