  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578914</data>
  <data key="d6"></data>
</node>
<node id="Testing Thoroughness">
  <data key="d0">Testing Thoroughness</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-003</data>
  <data key="d2">Many organizations satisfy basic compliance by merely deploying a CSP, but thorough testing evaluates meaningful reduction of reachable functionality rather than just header presence.</data>
  <data key="d1">AttackTechnique</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578914</data>
  <data key="d6"></data>
</node>
