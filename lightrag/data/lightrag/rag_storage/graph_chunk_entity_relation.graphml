  <data key="d5">1785498316</data>
  <data key="d6"></data>
</node>
<node id="Access-Control-Allow-Origin Header">
  <data key="d0">Access-Control-Allow-Origin Header</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A server response header indicating which domains are permitted to access a resource via CORS.&lt;SEP&gt;Server-sent HTTP header influencing which origins are permitted to make requests.&lt;SEP&gt;A server response header that specifies one or more permitted origins for which the CORS policy grants access to the response.</data>
  <data key="d3">doc-d89410974592b19e283a445bd3ea68aa-chunk-004&lt;SEP&gt;doc-d89410974592b19e283a445bd3ea68aa-chunk-002&lt;SEP&gt;doc-d89410974592b19e283a445bd3ea68aa-chunk-000</data>
