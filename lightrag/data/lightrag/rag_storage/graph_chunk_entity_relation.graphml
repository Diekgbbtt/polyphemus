<node id="Javascript Code Injection">
  <data key="d0">Javascript Code Injection</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">Adding malicious JavaScript code, typically via XSS or stored injection methods, intended to run within an unsuspecting user's browser.</data>
  <data key="d3">doc-b515367113bce44cf3564abc5019508d-chunk-003</data>
  <data key="d4">wstg-inpv-14-methodology.md</data>
  <data key="d5">1785582277</data>
  <data key="d6"></data>
</node>
<node id="Backdoor Data Persistence">
  <data key="d0">Backdoor Data Persistence</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A persistence mechanism where malicious data is injected into enterprise systems or shared layers, allowing client-side attacks to succeed due to weak input validation elsewhere in the organization.</data>
  <data key="d3">doc-b515367113bce44cf3564abc5019508d-chunk-003</data>
  <data key="d4">wstg-inpv-14-methodology.md</data>
  <data key="d5">1785582277</data>
  <data key="d6"></data>
</node>
<node id="Persistence Layer">
  <data key="d0">Persistence Layer</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A storage or database component in the target system where attack data can be stored long-term.</data>
  <data key="d3">doc-b515367113bce44cf3564abc5019508d-chunk-000</data>
  <data key="d4">wstg-inpv-14-methodology.md</data>
  <data key="d5">1785582277</data>
  <data key="d6"></data>
</node>
<node id="Outcome Delivery Mechanism">
  <data key="d0">Outcome Delivery Mechanism</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A system component or feature (such as forums or bulletin boards) that interacts with user data and may later render stored malicious content.</data>
  <data key="d3">doc-b515367113bce44cf3564abc5019508d-chunk-000</data>
  <data key="d4">wstg-inpv-14-methodology.md</data>
  <data key="d5">1785582277</data>
  <data key="d6"></data>
</node>
<node id="Backend Datastore">
  <data key="d0">Backend Datastore</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Database or storage system referenced in the context of storing injected or uploaded data.</data>
  <data key="d3">doc-b515367113bce44cf3564abc5019508d-chunk-000</data>
  <data key="d4">wstg-inpv-14-methodology.md</data>
  <data key="d5">1785582277</data>
  <data key="d6"></data>
</node>
<node id="Web Forum/Bulletin Board">
  <data key="d0">Web Forum/Bulletin Board</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">System component where stored XSS scripts can be later delivered to users.</data>
