<node id="Web Search Engine">
  <data key="d0">Web Search Engine</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A web-based tool that allows querying indexed web content using operators (e.g., site: operator) to discover hidden or non-advertised URLs.Description: A service such as Google, Bing, or DuckDuckGo that can be queried with domain-specific filters to find mentions of unknown subdomains or paths.</data>
  <data key="d3">doc-af827feaaf7735b8242b6a751ee616fa-chunk-002</data>
