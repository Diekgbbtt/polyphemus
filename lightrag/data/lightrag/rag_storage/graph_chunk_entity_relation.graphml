  <data key="d5">1785584088</data>
  <data key="d6"></data>
</node>
<node id="Cache-Control Header">
  <data key="d0">Cache-Control Header</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A response header detail that, if mishandled with response splitting, can exacerbate cache poisoning effects or reveal internal cache logic.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-001</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Carriage Return (CR) Character">
  <data key="d0">Carriage Return (CR) Character</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A specific control character (`\r`) often injected to split HTTP response headers.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Line Feed (LF) Character">
  <data key="d0">Line Feed (LF) Character</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A specific control character (`\n`) often injected to split HTTP response headers.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Unsanitized User Input">
  <data key="d0">Unsanitized User Input</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A target condition where user-supplied input is reflected into HTTP response headers without validation.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="`Location` Header">
  <data key="d0">`Location` Header</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A specific HTTP response header used to redirect requests or specify resource locations, often prone to splitting when URL components are mishandled.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="`Set-Cookie` Header">
  <data key="d0">`Set-Cookie` Header</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A specific HTTP response header used to set browser cookies, which can be manipulated to achieve session fixation or spoofing via response splitting.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Cache Poisoning">
  <data key="d0">Cache Poisoning</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">An strategic attack goal that manipulates intermediary caches to store malicious responses for distribution to other users.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Cross-site Scripting (XSS)">
  <data key="d0">Cross-site Scripting (XSS)</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">An strategic attack goal that injects malicious scripts into web pages viewed by other users, leading to account takeover or data theft.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Content Spoofing">
  <data key="d0">Content Spoofing</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">An strategic attack goal where injected content is used to misrepresent website information for social engineering or fraud.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Session Fixation">
  <data key="d0">Session Fixation</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">An strategic attack goal where an attacker forces a user to use a session token controlled by the attacker.&lt;SEP&gt;A weakness where the web application retains session identifiers before and after authentication without renewal.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-002&lt;SEP&gt;doc-2df0461e7868bf356c8b0363fdfc1a8b-chunk-000</data>
