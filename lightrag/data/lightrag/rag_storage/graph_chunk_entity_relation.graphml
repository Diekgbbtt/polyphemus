  <data key="d0">User Input Fields</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Target locations where user-supplied data enters the application including HTTP GET, POST queries, form submissions, and file uploads fields.&lt;SEP&gt;All user-facing input mechanisms including URL parameters, cookies, headers, and form values across requests</data>
  <data key="d3">doc-2efb3aacf8e172b84b6e1793e84eff76-chunk-001&lt;SEP&gt;doc-40abae0a95ecce566511731ae40acbbf-chunk-001</data>
