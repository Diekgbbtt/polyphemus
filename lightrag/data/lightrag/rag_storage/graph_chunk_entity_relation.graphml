</node>
<node id="Parameterized Query">
  <data key="d0">Parameterized Query</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A security practice where user input is passed as a placeholder parameter instead of being concatenated directly into query strings, preventing injection attacks.</data>
  <data key="d3">doc-4bbd60ae8a8276a511522c70e38b3d51-chunk-001</data>
  <data key="d4">wstg-inpv-05-6-methodology.md</data>
