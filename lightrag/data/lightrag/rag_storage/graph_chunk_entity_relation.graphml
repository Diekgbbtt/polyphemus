  <data key="d5">1785582568</data>
  <data key="d6"></data>
</node>
<node id="Location Header">
  <data key="d0">Location Header</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A target HTTP response header component that includes a URL redirected by the server.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-001</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="URL-encoded Data">
  <data key="d0">URL-encoded Data</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">Input that has undergone URL encoding to mask special characters, potentially leaving some encodings exploitable if validation is incomplete.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-001</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="Caching Behavior">
  <data key="d0">Caching Behavior</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">Establishing a poisoned cache entry for subsequent legitimate user requests to deliver malicious content without further involvement from the attacker or user.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-001</data>
  <data key="d4">wstg-inpv-15-methodology.md</data>
  <data key="d5">1785582324</data>
  <data key="d6"></data>
</node>
<node id="HTTP Protocol">
  <data key="d0">HTTP Protocol</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">The underlying communication protocol defining the structure of HTTP messages, headers, and how response splitting manipulates this structure.&lt;SEP&gt;A stateless protocol where cookies are used to provide state information between client and server requests.&lt;SEP&gt;The application-level protocol used to transmit data; lacks encryption by default compared to HTTPS.</data>
  <data key="d3">doc-1b71020ce840e0a943e1deda0b9f2c41-chunk-001&lt;SEP&gt;doc-e042301aa71030fa28c1652044efd184-chunk-004&lt;SEP&gt;doc-a2ab4b970856023b5f961a9117891837-chunk-002</data>
