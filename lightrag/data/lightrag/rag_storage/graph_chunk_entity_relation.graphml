  <data key="d0">Partial Wildcard Source Such as `*.cdn.com`</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-003</data>
  <data key="d2">A specific pattern within the broader category of wildcard sources used in Content Security Policy configurations.</data>
  <data key="d1">PayloadPattern</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578913</data>
  <data key="d6"></data>
</node>
<node id="Cross Site Scripting Vulnerability">
  <data key="d0">Cross Site Scripting Vulnerability</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-002</data>
  <data key="d2">Permits inline script execution that can bypass proper origin checking and lead to reflected XSS.</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578913</data>
  <data key="d6"></data>
</node>
<node id="Content-Security-Policy (Enforced)">
  <data key="d0">Content-Security-Policy (Enforced)</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-002</data>
  <data key="d2">Refers to moving from logger-only mode to fully enforced mode after policy validation.</data>
