  <data key="d6"></data>
</node>
<node id="Protocol Downgrade&lt;|AttackGoal|&gt;">
  <data key="d0">Protocol Downgrade&lt;|AttackGoal|&gt;</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">An attacker goal to force inconsistent parsing by downgrading protocol versions on intermediary proxies.</data>
