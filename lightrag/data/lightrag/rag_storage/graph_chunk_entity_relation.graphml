  <data key="d0">Artifact Public Download URL</data>
  <data key="d3">doc-d2ff4b7186c17bdc52457e2c1f1dc3fe-chunk-001</data>
  <data key="d2">This technique generates observable public download URLs as artifacts.</data>
  <data key="d1">Artifact</data>
  <data key="d4">wstg-info-10-methodology.md</data>
  <data key="d5">1785580822</data>
  <data key="d6"></data>
</node>
<node id="Stored Cross-site Scripting (XSS)">
  <data key="d0">Stored Cross-site Scripting (XSS)</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A persistent web application vulnerability where attacker-supplied malicious scripts are stored in the application's database/code and later executed in the victim's browser while the user is authenticated to the site.&lt;SEP&gt;A stored web application weakness where user-supplied data containing malicious scripts is saved in a data store and subsequently served in a web page without proper encoding or validation, leading to script execution in the victim's browser.</data>
  <data key="d3">doc-40abae0a95ecce566511731ae40acbbf-chunk-003&lt;SEP&gt;doc-40abae0a95ecce566511731ae40acbbf-chunk-000</data>
  <data key="d4">wstg-inpv-02-methodology.md</data>
  <data key="d5">1785580850</data>
  <data key="d6"></data>
</node>
<node id="Second-order Stored XSS">
  <data key="d0">Second-order Stored XSS</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">Subcategory of Stored XSS where execution requires an additional request that retrieves the stored malicious data.</data>
  <data key="d3">doc-40abae0a95ecce566511731ae40acbbf-chunk-003</data>
  <data key="d4">wstg-inpv-02-methodology.md</data>
  <data key="d5">1785580850</data>
  <data key="d6"></data>
</node>
<node id="Web Application Backend">
  <data key="d0">Web Application Backend</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">The server-side application or storage layer where user data is saved, processed, and later reflected back to users through dynamic pages.</data>
  <data key="d3">doc-40abae0a95ecce566511731ae40acbbf-chunk-003</data>
  <data key="d4">wstg-inpv-02-methodology.md</data>
