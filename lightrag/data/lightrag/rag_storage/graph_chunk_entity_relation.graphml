  <data key="d0">URL Fragment Identifier</data>
  <data key="d1">Artifact</data>
  <data key="d2">Optional part of a URL after the hash (#) symbol that is generally treated as data and not sent via HTTP request.</data>
  <data key="d3">doc-a331af288c84a3d43384e1ec0cd67904-chunk-000</data>
  <data key="d4">wstg-clnt-06-methodology.md</data>
  <data key="d5">1785497556</data>
