<node id="External Script Injection Payload">
  <data key="d0">External Script Injection Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">Malicious input that embeds an external `&lt;script&gt;` tag by embedding the closing script tag after an attribute separated by `&gt;`.</data>
  <data key="d3">doc-9a2a918bb83307307b4812469ae0001c-chunk-003</data>
