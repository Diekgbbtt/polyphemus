  <data key="d0">XMLHttpRequest</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A JavaScript API used to make HTTP requests from within a web page.&lt;SEP&gt;HTTP client API used to make network requests and potentially transport leaked data if combined with XSSI.</data>
  <data key="d3">doc-a331af288c84a3d43384e1ec0cd67904-chunk-000&lt;SEP&gt;doc-d89410974592b19e283a445bd3ea68aa-chunk-001&lt;SEP&gt;doc-f6cdc807870a77b5064fef34c66d10a7-chunk-000</data>
