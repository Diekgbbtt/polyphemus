  <data key="d0">Frontend HTTP Parser</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A HTTP request interpretation component located before the backend that may parse or normalize request boundaries differently from backend components.</data>
  <data key="d3">doc-8b6431100fb5694f9e64efa595cebe6c-chunk-002</data>
  <data key="d4">wstg-inpv-16-methodology.md</data>
  <data key="d5">1785582541</data>
  <data key="d6"></data>
</node>
<node id="Backend HTTP Parser">
  <data key="d0">Backend HTTP Parser</data>
  <data key="d1">TechnologyStack</data>
