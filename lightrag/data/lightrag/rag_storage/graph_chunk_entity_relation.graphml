</node>
<node id="CSRF-Token">
  <data key="d0">CSRF-Token</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A token value added to requests to ensure they originate from the web application itself, commonly used to mitigate Cross-Site Request Forgery.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-000</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="SameSite-Cookie-Attribute">
  <data key="d0">SameSite-Cookie-Attribute</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A cookie attribute that instructs the browser not to send cookies with cross-origin requests, used to reduce CSRF risk.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-000</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="Cross-Site State Change">
  <data key="d0">Cross-Site State Change</data>
  <data key="d1">ObservableSignal</data>
  <data key="d2">Indicator that the application reflects changes in state initiated by a request, which may confirm unintended action execution in the user's authenticated session.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-000</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
<node id="HTML-Image-Tag">
  <data key="d0">HTML-Image-Tag</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Client-side tag (e.g., `&lt;img&gt;`) that automatically sends a GET request to a specified HTTP(S) resource without requiring explicit user action or confirmation.</data>
