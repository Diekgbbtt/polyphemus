  <data key="d0">DOM Sink</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A user input field or DOM property that accepts and processes data before it is rendered or executed in the page.&lt;SEP&gt;A client-side JavaScript code location within the DOM where untrusted user input is stored and later used in dynamic scripting operations.</data>
  <data key="d3">doc-aa5c9321922fff53a8b5093aeb86d6b2-chunk-000&lt;SEP&gt;doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
