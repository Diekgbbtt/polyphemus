<node id="History Push State">
  <data key="d0">History Push State</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A JavaScript method (`history.pushState()`) used to modify the browser URL to avoid typical page reload detection mechanisms.</data>
