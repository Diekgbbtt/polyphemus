</node>
<node id="includeSubDomains directive">
  <data key="d0">includeSubDomains directive</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">HSTS header parameter instructing browsers to apply the HTTP Strict Transport Security policy to all sub-domains of the specified domain.</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-001</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578601</data>
  <data key="d6"></data>
</node>
<node id="preload directive">
  <data key="d0">preload directive</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">Unofficial HSTS parameter indicating the domain is on the browser preload list for mandatory HTTPS connections.</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-001</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578601</data>
  <data key="d6"></data>
</node>
<node id="MitM Attack">
  <data key="d0">MitM Attack</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-000&lt;SEP&gt;doc-0ebda215dbd761aff6a4d8bfb5c054ba-chunk-000</data>
  <data key="d2">Missing HSTS allows attackers to conduct man-in-the-middle attacks over unencrypted traffic.</data>
  <data key="d1">AttackTechnique</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578601</data>
