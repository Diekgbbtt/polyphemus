<node id="UNION SELECT SQL Injection">
  <data key="d0">UNION SELECT SQL Injection</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">A technique using union-based SQL injection to retrieve extra database data through crafted queries.</data>
