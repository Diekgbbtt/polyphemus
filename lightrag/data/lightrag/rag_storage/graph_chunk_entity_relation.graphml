<node id="Web Cache Deception">
  <data key="d0">Web Cache Deception</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">Exploit path confusion to influence cached responses and lead to unauthorized data disclosure or behavior execution.</data>
  <data key="d3">doc-29898427405fc044501f82e30c15f855-chunk-000</data>
  <data key="d4">wstg-conf-13-methodology.md</data>
  <data key="d5">1785578939</data>
