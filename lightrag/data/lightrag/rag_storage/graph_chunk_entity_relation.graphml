<node id="File Include Payload">
  <data key="d0">File Include Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A base64-encoded string containing malicious PHP code that is injected into parameter values for inclusion testing.&lt;SEP&gt;A template parameterized with vulnerable file path placeholders, such as `include/../../config.php`, used to probe for inclusion vulnerabilities.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000&lt;SEP&gt;doc-3145270b6ffe0fd7611c4610be0770a9-chunk-003</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Local File Inclusion">
  <data key="d0">Local File Inclusion</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness class where an application retrieves local files without proper validation of user-provided paths, often using directory traversal patterns.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Remote File Inclusion">
  <data key="d0">Remote File Inclusion</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness class where an application retrieves files from external URLs without proper validation of user-provided remote paths or root restrictions.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="File Inclusion">
  <data key="d0">File Inclusion</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A general vulnerability family comprising LFI and RFI where user input is blindly passed to file inclusion operations without sanitization.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Code Execution">
  <data key="d0">Code Execution</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">The strategic result of successfully exploiting file inclusion to run arbitrary scripts on the server or client.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Sensitive Information Disclosure">
  <data key="d0">Sensitive Information Disclosure</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">The strategic result of successfully exploiting file inclusion to fetch secret files such as configuration or password files.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Denial of Service">
  <data key="d0">Denial of Service</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">The strategic result of successfully exploiting file inclusion to consume server resources or trigger application crashes.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Included File Content Returned">
  <data key="d0">Included File Content Returned</data>
  <data key="d1">ObservableSignal</data>
  <data key="d2">Any visible or detectable output generated by the server after including an external target file, indicating a successful file inclusion.&lt;SEP&gt;Evidence indicating that a requested file was successfully included and its contents were sent in the application response.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-000&lt;SEP&gt;doc-3145270b6ffe0fd7611c4610be0770a9-chunk-003</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Local File Inclusion (LFI)">
  <data key="d0">Local File Inclusion (LFI)</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness where unsanitized user input is used to reference local files, potentially exposing sensitive data or configuration.&lt;SEP&gt;A weakness in input validation of file paths that allows an attacker to include arbitrary local files.&lt;SEP&gt;A weakness class where server-side code improperly includes local files based on untrusted input, enabling directory traversal and sensitive data disclosure. This vulnerability allows attackers to read local files or execute arbitrary content already present on the server through malicious path manipulation.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-004&lt;SEP&gt;doc-3145270b6ffe0fd7611c4610be0770a9-chunk-002&lt;SEP&gt;doc-3145270b6ffe0fd7611c4610be0770a9-chunk-001</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="Remote File Inclusion (RFI)">
  <data key="d0">Remote File Inclusion (RFI)</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness class where server-side code attempts to include or process files from external, remote URLs based on untrusted input, effectively turning the server into a web proxy for malicious hosts and allowing the delivery of arbitrary content such as malware or exploit code.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-004</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581676</data>
  <data key="d6"></data>
</node>
<node id="File Inclusion Point">
  <data key="d0">File Inclusion Point</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A target input field or functionality within an application that accepts user input specifying or referencing a file path for retrieval or inclusion.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-004</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581677</data>
  <data key="d6"></data>
</node>
<node id="Path Traversal (Directory Traversal)">
  <data key="d0">Path Traversal (Directory Traversal)</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An exploitation technique that injects directory traversal characters such as `../` into input fields in order to escape the intended directory and access files or resource outside the established web root or include folder.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-004</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581677</data>
  <data key="d6"></data>
</node>
<node id="User-Submitted Input">
  <data key="d0">User-Submitted Input</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Data source originating from users or external HTTP requests that may contain malicious content or unexpected values requiring verification before processing by the application.</data>
  <data key="d3">doc-3145270b6ffe0fd7611c4610be0770a9-chunk-004</data>
  <data key="d4">wstg-inpv-11-1-methodology.md</data>
  <data key="d5">1785581677</data>
  <data key="d6"></data>
</node>
