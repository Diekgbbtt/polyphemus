</node>
<node id="H2C Upgrade">
  <data key="d0">H2C Upgrade</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">A cleartext Upgrade mechanism that initiates an HTTP/2 connection within the same HTTP/1.1 socket without a prior TCP/connection upgrade.</data>
  <data key="d3">doc-8b6431100fb5694f9e64efa595cebe6c-chunk-002</data>
  <data key="d4">wstg-inpv-16-methodology.md</data>
  <data key="d5">1785582541</data>
  <data key="d6"></data>
</node>
<node id="Protocol Translation Layer">
  <data key="d0">Protocol Translation Layer</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A middleware, reverse proxy, or API gateway component responsible for converting HTTP/2 requests into HTTP/1.1 requests and vice versa for backend compatibility.</data>
  <data key="d3">doc-8b6431100fb5694f9e64efa595cebe6c-chunk-002</data>
  <data key="d4">wstg-inpv-16-methodology.md</data>
  <data key="d5">1785582541</data>
