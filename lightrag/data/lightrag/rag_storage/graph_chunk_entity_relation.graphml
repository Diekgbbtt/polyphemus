  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="Nonce Reuse">
  <data key="d0">Nonce Reuse</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A target condition where CSP nonces are reused across requests or generated predictably, creating security weaknesses exploitable by attackers.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-000</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="Fresh Nonce">
  <data key="d0">Fresh Nonce</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A target environment condition where each CSP response includes a unique, cryptographically strong nonce to prevent reuse-based attacks.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-000</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="Source-Origin Whitelist">
  <data key="d0">Source-Origin Whitelist</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">The allow-listed external origins declared in the Content-Security-Policy header or meta tag that determine permitted resource loaders.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-000</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="Script Execution Not Restricted By CSP">
  <data key="d0">Script Execution Not Restricted By CSP</data>
  <data key="d1">ObservableSignal</data>
  <data key="d2">A detection indicating that scripts were executed despite the presence of a CSP policy, signifying a bypass or misconfiguration.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-000&lt;SEP&gt;doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-002</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="object-src directive">
  <data key="d0">object-src directive</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A specific CSP directive that restricts the origins from which object resources (such as `&lt;embed&gt;`, `&lt;object&gt;`, `&lt;script&gt;`) can be loaded.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-001</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
<node id="base-uri directive">
  <data key="d0">base-uri directive</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A specific CSP directive controlling whether a document can set or modify its `&lt;base&gt;` element to change the context of relative URLs.</data>
  <data key="d3">doc-3ef7e3d50def7213b8e53e2fc6ca96f9-chunk-001</data>
  <data key="d4">wstg-conf-12-methodology.md</data>
  <data key="d5">1785578911</data>
  <data key="d6"></data>
</node>
