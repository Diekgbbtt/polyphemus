  <data key="d0">Dangling DNS Record</data>
  <data key="d1">ObservableSignal</data>
  <data key="d2">A DNS record that still resolves but points to an external resource that no longer exists or is unclaimed, indicating a subdomain takeover opportunity.</data>
  <data key="d3">doc-c13f010c37aa825f16fd20fc693f2648-chunk-000</data>
  <data key="d4">wstg-conf-10-methodology.md</data>
  <data key="d5">1785578685</data>
  <data key="d6"></data>
</node>
<node id="DNS Management Platform (Cloud/DNS Provider)">
  <data key="d0">DNS Management Platform (Cloud/DNS Provider)</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Target management interface where DNS records are configured and maintained; proper control on this platform prevents orphaned records post-deprovisioning.</data>
  <data key="d3">doc-c13f010c37aa825f16fd20fc693f2648-chunk-000</data>
