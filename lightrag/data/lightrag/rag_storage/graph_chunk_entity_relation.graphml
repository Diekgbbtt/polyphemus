  <data key="d5">1785582916</data>
  <data key="d6"></data>
</node>
<node id="__proto__ Key">
  <data key="d0">__proto__ Key</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A malicious property key inserted during polluting requests to attempt control of the prototype chain.&lt;SEP&gt;A specific property key that, when assigned, modifies the prototype chain of an object.</data>
  <data key="d3">doc-0afc271ddfef476dba107d5eebef758e-chunk-003&lt;SEP&gt;doc-0afc271ddfef476dba107d5eebef758e-chunk-002</data>
