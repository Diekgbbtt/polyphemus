<node id="Legal Notice Field (`notice` column in `footer` table)`">
  <data key="d0">Legal Notice Field (`notice` column in `footer` table)`</data>
  <data key="d3">doc-b515367113bce44cf3564abc5019508d-chunk-001</data>
  <data key="d2">The modified `notice` field value is rendered within the footer of the legitimate page viewed by users.</data>
