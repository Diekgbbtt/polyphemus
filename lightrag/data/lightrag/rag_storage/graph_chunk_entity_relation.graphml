<node id="HTTP Strict Transport Security (HSTS)">
  <data key="d0">HTTP Strict Transport Security (HSTS)</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A security feature implemented via an HTTP response header that enforces HTTPS connections for a domain and its sub-domains.&lt;SEP&gt;Web security feature/technical control that forces browsers to use HTTPS connections for a domain.</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-000&lt;SEP&gt;doc-e3d35387f319064504857847281b5d15-chunk-001</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578600</data>
  <data key="d6"></data>
</node>
<node id="Strict-Transport-Security Header">
  <data key="d0">Strict-Transport-Security Header</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">The HTTP response header that carries HSTS policy directives.&lt;SEP&gt;A server response header instructing browsers to enforce HTTPS communication in future requests.&lt;/description&gt;</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-000&lt;SEP&gt;doc-0ebda215dbd761aff6a4d8bfb5c054ba-chunk-002</data>
  <data key="d4">wstg-conf-07-methodology.md&lt;SEP&gt;wstg-cryp-01-methodology.md</data>
  <data key="d5">1785579032</data>
  <data key="d6"></data>
</node>
<node id="max-age Directive">
  <data key="d0">max-age Directive</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A numeric parameter in the HSTS header indicating the number of seconds a browser should enforce HTTPS.</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-000</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578600</data>
  <data key="d6"></data>
</node>
<node id="includeSubDomains Directive">
  <data key="d0">includeSubDomains Directive</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A directive in the HSTS header that applies the policy to all sub-domains of the domain.</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-000</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578600</data>
  <data key="d6"></data>
</node>
<node id="preload Directive">
  <data key="d0">preload Directive</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A directive in the HSTS header suggesting browsers should use HTTPS regardless of preloaded lists (not part of official specification).</data>
  <data key="d3">doc-e3d35387f319064504857847281b5d15-chunk-000</data>
  <data key="d4">wstg-conf-07-methodology.md</data>
  <data key="d5">1785578600</data>
  <data key="d6"></data>
