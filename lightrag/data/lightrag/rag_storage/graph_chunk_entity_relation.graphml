<node id="Single Quote">
  <data key="d0">Single Quote</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A single quote or double quote character used to break out of double-quoted attribute values in injection attacks.&lt;SEP&gt;A literal character `'` that attempts to terminate attribute values in XML input.&lt;SEP&gt;A common special character used in command injection payloads to enclose commands or interfere with shell interpretation.</data>
  <data key="d3">doc-9a2a918bb83307307b4812469ae0001c-chunk-002&lt;SEP&gt;doc-5bb2d236b1e2b43118e82283180ff198-chunk-002&lt;SEP&gt;doc-eff998e21395157f6ed4ce495ef006aa-chunk-004</data>
