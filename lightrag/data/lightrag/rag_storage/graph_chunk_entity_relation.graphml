  <data key="d0">HTTP Cookie Name Prefix `__Secure-`</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A cookie name prefix indicating that the cookie is only transmitted over secure connections.</data>
  <data key="d3">doc-2df0461e7868bf356c8b0363fdfc1a8b-chunk-002</data>
  <data key="d4">wstg-sess-03-methodology.md</data>
  <data key="d5">1785583420</data>
  <data key="d6"></data>
</node>
