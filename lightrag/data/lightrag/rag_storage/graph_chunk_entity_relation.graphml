</node>
<node id="Adversary">
  <data key="d0">Adversary</data>
  <data key="d1">AttackerCapability</data>
  <data key="d2">An unauthorized entity with the ability to discover vulnerable subdomains and register the same name on a different cloud account.</data>
  <data key="d3">doc-c13f010c37aa825f16fd20fc693f2648-chunk-001</data>
  <data key="d4">wstg-conf-10-methodology.md</data>
  <data key="d5">1785578685</data>
  <data key="d6"></data>
</node>
