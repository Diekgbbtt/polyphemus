  <data key="d0">Browser Cache</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A client-side storage mechanism designed to temporarily store rendered responses for performance improvement.&lt;SEP&gt;A web browser storage mechanism that crawls/loads cached versions of previously downloaded resources to improve performance.</data>
  <data key="d3">doc-536e7409d2b781ede98f0ff8ef399eed-chunk-001&lt;SEP&gt;doc-536e7409d2b781ede98f0ff8ef399eed-chunk-000</data>
