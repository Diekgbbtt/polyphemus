  <data key="d0">Path Confusion Vulnerability</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">Incorrect application path matching that permits access or execution when paths should have been rejected.</data>
  <data key="d3">doc-29898427405fc044501f82e30c15f855-chunk-000</data>
  <data key="d4">wstg-conf-13-methodology.md</data>
