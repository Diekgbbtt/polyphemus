  <data key="d4">wstg-sess-04-methodology.md</data>
  <data key="d5">1785583475</data>
  <data key="d6"></data>
</node>
<node id="Session-Management-Reliance">
  <data key="d0">Session-Management-Reliance</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">Application session management that exclusively depends on browser-stored information such as cookies or HTTP authentication to identify and authorize user sessions.</data>
  <data key="d3">doc-35af4670be2579d771f8aacc9dfbff92-chunk-000</data>
  <data key="d4">wstg-sess-05-methodology.md</data>
  <data key="d5">1785583536</data>
  <data key="d6"></data>
</node>
