<node id="Hidden Input Field">
  <data key="d0">Hidden Input Field</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An action that includes hidden fields in an HTML form to silently transmit malicious parameters alongside legitimate ones.</data>
