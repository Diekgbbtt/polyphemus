  <data key="d0">CORS Preflight</data>
  <data key="d3">doc-4fc774259228cd414282425d0a281e37-chunk-004</data>
  <data key="d2">Sending OPTIONS requests to probe server to determine allowed origins and headers for cross-origin resource sharing policies.</data>
