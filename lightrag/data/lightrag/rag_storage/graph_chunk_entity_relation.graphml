<node id="Username Parameter">
  <data key="d0">Username Parameter</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A specific user input field in the application that processes username or identifier data often used as an injection vector.&lt;SEP&gt;A user-supplied input field specifically for entering a username value during authentication.&lt;SEP&gt;A target input field condition where the parameter value is user-supplied.</data>
  <data key="d3">doc-2efb3aacf8e172b84b6e1793e84eff76-chunk-001&lt;SEP&gt;doc-ab2f517f1c742be6f3d510cb76dc6940-chunk-001&lt;SEP&gt;doc-c97667ce0118a17b753aecd821dcef59-chunk-002</data>
