  <data key="d0">Server Side Permutations</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">Processing performed by the server that alters input data before it reaches the client-side JavaScript for injection.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Browser Encoding">
  <data key="d0">Browser Encoding</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A condition where the client-side browser processes special characters or encodings (e.g., for URL or referrer components) prior to interaction with JavaScript sinks.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Automated Testing Tools">
  <data key="d0">Automated Testing Tools</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Software tools that send payloads and observe server responses to identify reflected XSS; limited effectiveness against DOM-based variants without deeper client-side code analysis.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Manual Testing">
  <data key="d0">Manual Testing</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">Method of reviewing client-side code and dynamically constructed DOM elements to identify areas susceptible to XSS input manipulation.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496786</data>
  <data key="d6"></data>
</node>
<node id="Request Input Fields">
  <data key="d0">Request Input Fields</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">Location in web application code where user-provided data is referenced and inserted into the Document Object Model.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Dynamic DOM Writing Code">
  <data key="d0">Dynamic DOM Writing Code</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">Code sections that generate, modify, or append DOM content based on untrusted or unvalidated input.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Event Handlers (JS)">
  <data key="d0">Event Handlers (JS)</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">JavaScript event handlers where user-controlled data might be used in handler logic or attribute values.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="CSS Expression Attributes">
  <data key="d0">CSS Expression Attributes</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Active content attributes such as `expression` in CSS that can execute JavaScript code upon rendering.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Off-Site Script/CSS Objects">
  <data key="d0">Off-Site Script/CSS Objects</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">External stylesheets or scripts hosted on third-party domains that may introduce malicious or proxy-controlled code execution.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Documented Browsers">
  <data key="d0">Documented Browsers</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Specific web browsers documented or referenced for their behavior regarding URL components and referrer elements.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-004</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="DOM-Based Cross Site Scripting">
  <data key="d0">DOM-Based Cross Site Scripting</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A security flaw in a web application where user input is reflected by client-side JavaScript to the Document Object Model without proper encoding or sanitization, allowing execution of injected malicious scripts.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-000</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Client-Rendered User Input">
  <data key="d0">Client-Rendered User Input</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A condition where user-provided data rendered directly into the client-side page content by JavaScript without server-side sanitization.&lt;SEP&gt;A condition where user input is processed and reflected by client-side JavaScript on page rendering.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-000&lt;SEP&gt;doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Malicious Fragment Anchor Injection">
  <data key="d0">Malicious Fragment Anchor Injection</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">A specific action where an attacker appends malicious script code as a URL fragment (after the '#') to trigger immediate execution without server transmission.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-000</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Server-Side Injection">
  <data key="d0">Server-Side Injection</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">A testing action where untrusted user input is injected into JavaScript code originating from the web server response.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Client-Side JavaScript Object">
  <data key="d0">Client-Side JavaScript Object</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A JavaScript variable or object used in client-side code, which may receive and store user input without server-side sanitization.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Dynamic JavaScript Execution">
  <data key="d0">Dynamic JavaScript Execution</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A web application behavior where JavaScript code is generated or manipulated on the client-side based on user interaction or server payloads.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="JavaScript Cross-Site Scripting (DOM XSS)">
  <data key="d0">JavaScript Cross-Site Scripting (DOM XSS)</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">Execution of malicious script within the context of a user's session due to unsafe handling of user input in dynamic JavaScript.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Automated XSS Scanner">
  <data key="d0">Automated XSS Scanner</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">Target mechanism that performs surface-level pattern matching to detect reflected XSS but often fails to detect DOM-based variants due to client-side execution.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Browser Script Block">
  <data key="d0">Browser Script Block</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">JavaScript placed inside event handlers (`onclick`, `onload`, etc.) or CSS expression attributes where user input might be rendered.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Large JavaScript Library">
  <data key="d0">Large JavaScript Library</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A third-party library or large in-house script containing hundreds of thousands of lines of code that can obscure sinks.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="DOM-Based Cross-Site Scripting">
  <data key="d0">DOM-Based Cross-Site Scripting</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness class where user input rendered by JavaScript in the browser is reflected without proper encoding into the DOM, leading to code execution.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Single Page Application">
  <data key="d0">Single Page Application</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A web application architecture where content is dynamically generated and updated on the client using JavaScript without full page reloads.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="JavaScript Sink">
  <data key="d0">JavaScript Sink</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An action where malicious input is injected into JavaScript functions that write to the DOM (e.g., document.write() or innerHTML access).</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="JavaScript Source">
  <data key="d0">JavaScript Source</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An action where user input is extracted from the browser environment (e.g., `window.location`, `document.referrer`, `navigator.userAgent`) and passed to manipulation functions.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="Server-Side Filtering">
  <data key="d0">Server-Side Filtering</data>
  <data key="d1">DefensiveControl</data>
  <data key="d2">A server-side security mechanism that sanitizes or blocks malicious data before it is passed to the application or client.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="man-in-the-middle attack potential">
  <data key="d0">man-in-the-middle attack potential</data>
  <data key="d1">AttackerCapability</data>
  <data key="d2">An attacker ability to observe, modify, or inject traffic between the user and server to exploit client-side processing flaws.</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-002</data>
  <data key="d4">wstg-clnt-01-methodology.md</data>
  <data key="d5">1785496787</data>
  <data key="d6"></data>
</node>
<node id="DOM XSS">
  <data key="d0">DOM XSS</data>
  <data key="d3">doc-dd948cd6478c95cb615c3b86568b8163-chunk-001&lt;SEP&gt;doc-507feea21a2b9071c451f23d5f3c743d-chunk-002</data>
  <data key="d2">Surface-level scanners fail to detect DOM-based XSS because payloads are executed on the client-side and not reflected in server responses.&lt;SEP&gt;A class of web application vulnerabilities where malicious scripts are executed within the web page's DOM.</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d4">wstg-clnt-01-methodology.md&lt;SEP&gt;wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Client-Side Testing">
  <data key="d0">Client-Side Testing</data>
  <data key="d1">Artifact</data>
  <data key="d2">A defined test category within the WSTG focused on client-side interaction validation.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-002</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="HTML Injection">
  <data key="d0">HTML Injection</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A weakness class where user input is inserted into HTML without proper encoding, allowing script execution.&lt;SEP&gt;A weakness where untrusted input is inserted into HTML output without proper encoding or sanitization mechanisms. This allows attackers to modify page content or execute unauthorized scripts in the victim's context.&lt;SEP&gt;A client-side injection weakness that allows arbitrary HTML to be rendered in the victim's browser.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-002&lt;SEP&gt;doc-507feea21a2b9071c451f23d5f3c743d-chunk-001&lt;SEP&gt;doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Window Object">
  <data key="d0">Window Object</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">The underlying JavaScript API object exposed in the browser environment.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-002</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="HTML Code Injection">
  <data key="d0">HTML Code Injection</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">An action that inserts crafted HTML code into an input field expecting plain text.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-002</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Script Tag">
  <data key="d0">Script Tag</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A reusable structure of HTML tags designed to deliver JavaScript for DOM XSS exploitation.&lt;SEP&gt;HTML markup used to include external scripts, often involving cross-origin sources.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-002&lt;SEP&gt;doc-f6cdc807870a77b5064fef34c66d10a7-chunk-004</data>
  <data key="d4">wstg-clnt-03-methodology.md&lt;SEP&gt;wstg-clnt-13-methodology.md</data>
  <data key="d5">1785498814</data>
  <data key="d6"></data>
</node>
<node id="innerHTML">
  <data key="d0">innerHTML</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A JavaScript DOM property used to set or retrieve the HTML content of an element, often vulnerable when untrusted input is used directly without encoding.&lt;SEP&gt;DOM property or manipulation method that directly sets HTML content from external sources, leading to injection.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-001&lt;SEP&gt;doc-a331af288c84a3d43384e1ec0cd67904-chunk-002</data>
  <data key="d4">wstg-clnt-03-methodology.md&lt;SEP&gt;wstg-clnt-06-methodology.md</data>
  <data key="d5">1785497557</data>
  <data key="d6"></data>
</node>
<node id="document.write()">
  <data key="d0">document.write()</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">A specific JavaScript method that outputs a string of HTML as document content. If called with untrusted input, it introduces an HTML injection vulnerability.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-001</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="User-Inserted HTML">
  <data key="d0">User-Inserted HTML</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A reusable template or parameterized structure containing malicious HTML markup provided by an attacker as input to a vulnerable output sink.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-001</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="HTML Context Injection">
  <data key="d0">HTML Context Injection</data>
  <data key="d1">AttackTechnique</data>
  <data key="d2">Concrete action that injects malicious HTML via vulnerable input rendering methods.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Arbitrary HTML Rendering">
  <data key="d0">Arbitrary HTML Rendering</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">Widely used web page rendering behavior provided by browsers to display HTML.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="InnerHTML JavaScript Method">
  <data key="d0">InnerHTML JavaScript Method</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A JavaScript function used to set or get the HTML content of an element, often vulnerable to injection when fed user input.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Document.write() JavaScript Function">
  <data key="d0">Document.write() JavaScript Function</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">A JavaScript function used to write dynamically generated HTML text into the DOM, frequently abused in injection testing.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Malicious HTML Payload">
  <data key="d0">Malicious HTML Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">Reusable structure of HTML tags and attributes designed to compromise web page execution context.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Impersonation">
  <data key="d0">Impersonation</data>
  <data key="d1">AttackGoal</data>
  <data key="d2">A potential consequence of successful injection allowing the attacker to act as the victim.&lt;SEP&gt;Objective to assume the identity of a legitimate authenticated user through captured session data.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000&lt;SEP&gt;doc-2138db10de64fa713c14c45b2f2d6483-chunk-002</data>
  <data key="d4">wstg-clnt-03-methodology.md&lt;SEP&gt;wstg-sess-04-methodology.md</data>
  <data key="d5">1785583470</data>
  <data key="d6"></data>
</node>
<node id="Browser Execution of Malicious Code">
  <data key="d0">Browser Execution of Malicious Code</data>
  <data key="d1">ObservableSignal</data>
  <data key="d2">A detectable indicator when the browser executes JavaScript or renders unexpected content as a result of injection.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="Vulnerable HTML Output">
  <data key="d0">Vulnerable HTML Output</data>
  <data key="d1">TechnologyStack</data>
  <data key="d2">HTML content rendered by the browser that directly reflects unfiltered user input.</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-000</data>
  <data key="d4">wstg-clnt-03-methodology.md</data>
  <data key="d5">1785497018</data>
  <data key="d6"></data>
</node>
<node id="InnerHTML">
  <data key="d0">InnerHTML</data>
  <data key="d3">doc-507feea21a2b9071c451f23d5f3c743d-chunk-001</data>
  <data key="d2">A vulnerable `innerHTML` call may accept untrusted input directly, enabling HTML injection.</data>
  <data key="d1">TechnologyStack</data>
