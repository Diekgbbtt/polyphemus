</node>
<node id="UNION SELECT Payload">
  <data key="d0">UNION SELECT Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A SQL payload that appends a `UNION SELECT` clause to combine attacker-provided data with legitimate result sets.</data>
  <data key="d3">doc-39047a18b515fcf5a6bcfa50dda4ee3a-chunk-001</data>
