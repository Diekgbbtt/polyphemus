</node>
<node id="Microservice Internal Service Reachability">
  <data key="d0">Microservice Internal Service Reachability</data>
  <data key="d1">PreconditionEnvironment</data>
  <data key="d2">A condition where internal microservice endpoints are reachable from compromised parts of the system, facilitating lateral movement.</data>
  <data key="d3">doc-136da9e7ebc65a69c7a4923c2daacd7b-chunk-000</data>
