<node id="PHP Configuration Issue">
  <data key="d0">PHP Configuration Issue</data>
  <data key="d1">VulnerabilityClass</data>
  <data key="d2">A server configuration weakness allowing arbitrary file reading or extension interpretation through malformed inputs.</data>
  <data key="d3">doc-dd80fa5ebb19e9944238770f478851fb-chunk-001</data>
  <data key="d4">htb-airtouch-methodology.md</data>
  <data key="d5">1785754764</data>
