  <data key="d12">1785757887</data>
  <data key="d13"></data>
</edge>
<edge source="Escalate Privileges" target="Source Code Review">
  <data key="d7">2.0</data>
  <data key="d8">The review process can identify implementation flaws, insecure authorization checks, or dangerous function calls that facilitate privilege escalation.&lt;SEP&gt;Code review reveals role mismatch or authorization flaws that enable privilege escalation.&lt;SEP&gt;Reviewing code can uncover logic flaws that permit privilege escalation chains.</data>
  <data key="d9">supports</data>
  <data key="d10">doc-8047b6c93b09b89977542720f829a1da-chunk-002&lt;SEP&gt;doc-5b3691250d8034efc538f45153325e82-chunk-001&lt;SEP&gt;doc-495dc2d2fa3a0bb201cd26ebaa77ad10-chunk-001</data>
