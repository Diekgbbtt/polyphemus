<node id="PHP Alternate Extension Payload">
  <data key="d0">PHP Alternate Extension Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A malicious input pattern that uses alternative PHP extensions to bypass upload filters based on known extension blacklists.</data>
  <data key="d3">doc-dd80fa5ebb19e9944238770f478851fb-chunk-002&lt;SEP&gt;doc-dd80fa5ebb19e9944238770f478851fb-chunk-001</data>
