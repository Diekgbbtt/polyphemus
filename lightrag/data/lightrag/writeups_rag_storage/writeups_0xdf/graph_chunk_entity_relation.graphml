  <data key="d5">1785758007</data>
  <data key="d6"></data>
</node>
<node id="Time-Based SQL Payload">
  <data key="d0">Time-Based SQL Payload</data>
  <data key="d1">PayloadPattern</data>
  <data key="d2">A SQL payload that uses carefully timed sleep or delay functions to infer query response times for blind injection.</data>
  <data key="d3">doc-39047a18b515fcf5a6bcfa50dda4ee3a-chunk-001</data>
  <data key="d4">htb-cctv-methodology.md</data>
